# Remember, a 'rule' in a makefile takes the shape of:
# target(s): prerequisite(s)
# 	command
# 	...
# 	command
#
# We can have multiple 'targets', just like how we can have multiple 
# "prerequisites" they just need to be all in the same line as follows:
all: f1.o f2.o

f1.o f2.o:
	@echo "f1.o"
	@echo "f2.o"
